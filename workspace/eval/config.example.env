# Copy this file to .env or point EVAL_CONFIG at another shell-compatible file.
# Keep real credentials out of config.example.env and source control.

# Deployed trained policy (OpenAI-compatible /v1 endpoint).
POLICY_BASE_URL=http://127.0.0.1:8000/v1
POLICY_MODEL=clarq-policy
POLICY_API_KEY=EMPTY
POLICY_TIMEOUT=120
POLICY_MAX_RETRIES=3
POLICY_TEMPERATURE=0
POLICY_MAX_TOKENS=512
POLICY_ENABLE_THINKING=false

# Qwen3-32B user simulator used during training.
USER_SIMULATOR_BASE_URL=http://127.0.0.1:8005/v1
USER_SIMULATOR_MODEL=clarq-user-simulator
USER_SIMULATOR_API_KEY=EMPTY
USER_SIMULATOR_TIMEOUT=120
USER_SIMULATOR_MAX_RETRIES=3

# User simulation mode: grounded (training-compatible, default) or random.
# Random mode samples varied behaviors reproducibly with the configured seed.
EVAL_USER_SIMULATOR_MODE=grounded
EVAL_RANDOM_USER_SIMULATOR_SEED=
EVAL_RANDOM_USER_REPHRASE_PROBABILITY=0.16
EVAL_RANDOM_USER_COMPRESS_KNOWN_PROBABILITY=0.79
EVAL_RANDOM_USER_PROACTIVE_KNOWN_ON_UNKNOWN=true
EVAL_RANDOM_USER_PROACTIVE_KNOWN_PROBABILITY=0.47

# Optional detailed trajectory-quality Judge. Leave URL/model/key empty to reuse
# the user simulator. This is separate from the mandatory Success Judge.
JUDGE_BASE_URL=
JUDGE_MODEL=
JUDGE_API_KEY=
JUDGE_TIMEOUT=120
JUDGE_MAX_RETRIES=3

# Mandatory fallback judge for Success when the final Top-K does not contain the
# canonical title. Leave URL/model/key empty to reuse JUDGE_* or the simulator.
SUCCESS_JUDGE_BASE_URL=
SUCCESS_JUDGE_MODEL=
SUCCESS_JUDGE_API_KEY=
SUCCESS_JUDGE_TIMEOUT=
SUCCESS_JUDGE_MAX_RETRIES=

# Exact CaseRetriever configuration used by training.
SEARCH_SERVER_HOST=http://127.0.0.1:9200
SEARCH_SERVER_STRATEGY=hybrid
ELASTICSEARCH_INDEX=clarq_cases
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_CA_CERT=
ELASTICSEARCH_VERIFY_CERTS=true

EMBEDDING_URL=http://127.0.0.1:8001/v1/embeddings
EMBEDDING_MODEL=clarq-embedding
EMBEDDING_API_KEY=EMPTY
SEARCH_RANK_WINDOW=50
VECTOR_NUM_CANDIDATES=200
BM25_TITLE_BOOST=3.0
RRF_RANK_CONSTANT=60
RRF_BM25_WEIGHT=1.0
RRF_TITLE_VECTOR_WEIGHT=1.0
RRF_ANSWER_VECTOR_WEIGHT=1.0
SEARCH_TIMEOUT=30
EMBEDDING_TIMEOUT=60

# Evaluation defaults.
CASE_DOCUMENT_PATH=workspace/ClarQ/case_answers_with_title.json
EVAL_WORKERS=4
EVAL_MAX_TURNS=6
EVAL_MAX_SEARCHES=4
EVAL_TOP_K=5
EVAL_SUCCESS_TOP_K=3
EVAL_K_VALUES=1,3,5
EVAL_CASE_CONTENT_CHARS=1000
EVAL_SEED=42
EVAL_DOMAINS=
